<Project>

  <PropertyGroup>
    <!-- A push to release publishes this version. develop already carries the next minor, hotfixes on release raise the patch. -->
    <Version>1.3.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <ProjectRootDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</ProjectRootDir>
    <!-- SDK-Hook nach dem csproj, aber vor der Ausgabepfad-Berechnung: nur dort ist OutputType bekannt. -->
    <BeforeTargetFrameworkInferenceTargets>$(MSBuildThisFileDirectory)OutputPaths.targets</BeforeTargetFrameworkInferenceTargets>
  </PropertyGroup>

</Project>

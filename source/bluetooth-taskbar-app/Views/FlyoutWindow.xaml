<Window x:Class="Nc2.BluetoothTaskbarApp.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Nc2.BluetoothTaskbarApp.Views"
        Title="Bluetooth"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <views:DeviceKindToGeometryConverter x:Key="KindToIcon" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:StatusSeverityToBrushConverter x:Key="SeverityToBrush" />
        <views:BatteryPercentToGlyphConverter x:Key="BatteryToGlyph" />
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow; the border is the visible surface. -->
    <Border Margin="12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Header ============ -->
            <Grid Grid.Row="0" Margin="14,11,8,9">
                <TextBlock Text="Bluetooth"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" />

                <Button Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Refresh device list">
                    <Path Data="{StaticResource Icon.Refresh}"
                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          Width="16" Height="16"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource SeparatorBrush}" />

            <!-- ============ Device list ============ -->
            <ScrollViewer Grid.Row="2"
                          MaxHeight="392"
                          Margin="0,4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowDeviceList, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                </ScrollViewer.Resources>

                <ItemsControl ItemsSource="{Binding Devices}" Focusable="False" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row"
                                    Margin="6,1"
                                    Padding="8,7"
                                    CornerRadius="4"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Shared so every row's toggle lines up, battery or not. -->
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Battery" />
                                    </Grid.ColumnDefinitions>

                                    <Path x:Name="DeviceIcon"
                                          Grid.Column="0"
                                          Width="20" Height="20"
                                          Margin="0,0,11,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Data="{Binding Kind, Converter={StaticResource KindToIcon}}"
                                          Fill="{StaticResource SubtleTextBrush}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   Margin="0,1,0,0"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <ToggleButton Grid.Column="2"
                                                  Style="{StaticResource BreezeToggle}"
                                                  Margin="10,0,2,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsToggleEnabled}"
                                                  Visibility="{Binding IsToggleVisible,
                                                               Converter={StaticResource BoolToVisibility}}" />

                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Margin="12,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                TextElement.Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                Visibility="{Binding IsBatteryVisible,
                                                             Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}"
                                                   FontSize="15"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BatteryPercent, Converter={StaticResource BatteryToGlyph}}"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                    <Setter TargetName="DeviceIcon" Property="Fill" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ============ Radio off / nothing paired ============ -->
            <StackPanel Grid.Row="2"
                        Margin="14,22,14,24"
                        Visibility="{Binding ShowMessage, Converter={StaticResource BoolToVisibility}}">
                <Path Width="28" Height="28"
                      Stretch="Uniform"
                      Opacity="0.4"
                      Fill="{StaticResource SubtleTextBrush}"
                      HorizontalAlignment="Center">
                    <Path.Style>
                        <!-- Data lives in the style, not as an attribute: a local
                             value would outrank the trigger and never change. -->
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource Icon.Bluetooth}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRadioOn}" Value="False">
                                    <Setter Property="Data" Value="{StaticResource Icon.BluetoothOff}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding MessageText}"
                           Margin="0,10,0,0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}" />
            </StackPanel>

            <Border Grid.Row="3" Height="1" Background="{StaticResource SeparatorBrush}" />

            <!-- ============ Footer ============ -->
            <Grid Grid.Row="4">
                <Button Style="{StaticResource FooterButton}"
                        Margin="6,5,6,6"
                        Command="{Binding OpenSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Settings}"
                              Width="15" Height="15"
                              Margin="2,0,10,0"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <TextBlock Text="Configure Bluetooth…"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </StackPanel>
                </Button>

                <!-- Drawn over the button so the whole footer stays clickable. -->
                <TextBlock Text="{Binding VersionText}"
                           Margin="0,0,16,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10.5"
                           Opacity="0.7"
                           IsHitTestVisible="False"
                           Foreground="{StaticResource SubtleTextBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>

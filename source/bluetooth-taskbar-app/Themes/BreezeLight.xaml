<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Breeze Light palette (KDE Plasma). Same keys as BreezeDark.xaml. -->

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFCFC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C9CED2" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E0E3E6" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E8EBEE" />
    <SolidColorBrush x:Key="PressedBrush" Color="#DCE0E3" />

    <SolidColorBrush x:Key="TextBrush" Color="#232629" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6E767E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3DAEE9" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2C9AD6" />
    <SolidColorBrush x:Key="NegativeBrush" Color="#C9303F" />

    <SolidColorBrush x:Key="TrackOffBrush" Color="#C3C8CC" />
    <SolidColorBrush x:Key="ThumbOffBrush" Color="#FCFCFC" />
    <SolidColorBrush x:Key="ThumbOnBrush" Color="#FCFCFC" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B3B9BE" />

    <!-- Battery bands; darker than in the dark palette, plain yellow vanishes on white. -->
    <SolidColorBrush x:Key="BatteryLowBrush" Color="#B08600" />
    <SolidColorBrush x:Key="BatteryVeryLowBrush" Color="#C85A00" />
    <SolidColorBrush x:Key="BatteryCriticalBrush" Color="#C02232" />

</ResourceDictionary>

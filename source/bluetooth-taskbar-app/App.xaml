<Application x:Class="Nc2.BluetoothTaskbarApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette first; SystemTheme swaps it for BreezeLight.xaml in light mode. -->
                <ResourceDictionary Source="Themes/BreezeDark.xaml" />
                <ResourceDictionary Source="Themes/Breeze.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
